{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sfmc-slack-notify",
  "main": "src/worker/entry.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/config.json", "/health", "/activity/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GATE", "class_name": "ChannelGate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChannelGate"] }],
  // Secrets (wrangler secret put): SLACK_BOT_TOKEN, JWT_SIGNING_SECRET.
  // Text variables are set in the dashboard and kept by `deploy --keep-vars`:
  // APPLICATION_EXTENSION_KEY, SFMC_SUBDOMAIN, SFMC_ENTERPRISE_ID (optional).
  "vars": {}
}
