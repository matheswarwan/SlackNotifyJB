{
  "workflowApiVersion": "1.1",
  "type": "REST",
  "metaData": {
    "icon": "icon.png",
    "category": "message",
    "isConfigured": false,
    "configOnDrop": true
  },
  "lang": {
    "en-US": {
      "name": "Slack Notify",
      "description": "Post a Slack message when a contact reaches this step"
    }
  },
  "arguments": {
    "execute": {
      "inArguments": [],
      "outArguments": [],
      "url": "https://YOUR_WORKER_HOST/activity/execute",
      "useJwt": true,
      "timeout": 20000,
      "retryCount": 1,
      "retryDelay": 1000,
      "concurrentRequests": 5
    }
  },
  "configurationArguments": {
    "applicationExtensionKey": "YOUR_INSTALLED_PACKAGE_EXTENSION_KEY",
    "save": { "url": "https://YOUR_WORKER_HOST/activity/save", "useJwt": true },
    "publish": { "url": "https://YOUR_WORKER_HOST/activity/publish", "useJwt": true },
    "validate": { "url": "https://YOUR_WORKER_HOST/activity/validate", "useJwt": true },
    "stop": { "url": "https://YOUR_WORKER_HOST/activity/stop", "useJwt": true },
    "unpublish": { "url": "https://YOUR_WORKER_HOST/activity/unpublish", "useJwt": true }
  },
  "userInterfaces": {
    "configModal": { "height": 720, "width": 800 }
  },
  "schema": {
    "arguments": {
      "execute": { "inArguments": [], "outArguments": [] }
    }
  }
}
